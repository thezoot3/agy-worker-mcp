{
  "name": "multi-turn",
  "description": "Two distinct turns for a single stream-json process (docs/02 §6: one process, stdin stays open, num_turns increases, context implicitly carries). Used for agy_send / session_mode:'session' tests (docs/04 #6): turn 1 answers the first prompt, turn 2 (queued via the inbox) answers with a different, recognizable string so a test can prove num_turns went 1 -> 2 and the second response actually ran.",
  "model": "gemini-3.7-flash-low",
  "turns": [
    {
      "steps": [
        { "type": "agent_response", "chunks": [], "duration_seconds": 0.6, "usage": [16000, 40] },
        {
          "type": "tool",
          "tool_name": "run_command",
          "parameters": { "CommandLine": "echo turn-one" },
          "output": "turn-one\n",
          "duration_seconds": 0.05
        },
        { "type": "agent_response", "chunks": ["TURN1-DONE"], "duration_seconds": 0.6, "usage": [16050, 20] }
      ],
      "status": "SUCCESS",
      "response": "TURN1-DONE",
      "duration_seconds": 1.3
    },
    {
      "steps": [
        { "type": "agent_response", "chunks": [], "duration_seconds": 0.5, "usage": [16070, 30] },
        {
          "type": "tool",
          "tool_name": "run_command",
          "parameters": { "CommandLine": "echo turn-two" },
          "output": "turn-two\n",
          "duration_seconds": 0.05
        },
        { "type": "agent_response", "chunks": ["TURN2-DONE"], "duration_seconds": 0.5, "usage": [16090, 20] }
      ],
      "status": "SUCCESS",
      "response": "TURN2-DONE",
      "duration_seconds": 1.1
    }
  ]
}
